table Calendar
	lineageTag: 27115caa-87b9-4d34-8dd0-477ac60623bb

	column Date
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 0ac69066-ffd7-4977-b0f0-6fbd136d5698
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: ace04bb5-7c2b-4361-a83f-5b5ddabe31b2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 07cd6ccb-5b34-49f6-b9b3-56b309631376
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: MonthNo

		annotation SummarizationSetBy = Automatic

	column MonthNo
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 31dae83c-7ae9-43d2-b3cc-a392c43568d6
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source =
				VAR first = CALCULATE ( MIN ( upi_apps[month] ), REMOVEFILTERS () )
				VAR months = DATEDIFF ( first, CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () ), MONTH )
				RETURN
				    ADDCOLUMNS (
				        SELECTCOLUMNS ( GENERATESERIES ( 0, months ), "Date", EDATE ( first, [Value] ) ),
				        "Year", YEAR ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM yy" ),
				        "MonthNo", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				    )

