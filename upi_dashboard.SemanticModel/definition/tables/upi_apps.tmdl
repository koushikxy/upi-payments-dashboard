table upi_apps
	lineageTag: 04e9a739-3e7b-4000-a516-fdcb883caa5f

	measure 'Volume (Mn)' = SUM ( upi_apps[volume_mn] )
		formatString: #,0
		lineageTag: b1b46cc4-3ec6-40a5-ad30-521badf6a57c

	measure 'Value (Cr)' =
			VAR missing =
			    CALCULATE ( COUNTROWS ( upi_apps ), ISBLANK ( upi_apps[value_cr] ), REMOVEFILTERS ( upi_apps[app], upi_apps[app_type], upi_apps[App Group] ) )
			RETURN
			    IF ( missing > 0, BLANK (), SUM ( upi_apps[value_cr] ) )
		formatString: #,0
		lineageTag: 52d8a03d-32ce-4abd-a7f9-ee0f7eb9304e

	measure 'Avg Ticket (₹)' = DIVIDE ( [Value (Cr)] * 1e7, [Volume (Mn)] * 1e6 )
		formatString: #,0
		lineageTag: 6c38ad89-b075-4faa-8bc1-3734471be48f

	measure 'Volume Share' = DIVIDE ( [Volume (Mn)], CALCULATE ( [Volume (Mn)], REMOVEFILTERS ( upi_apps[app], upi_apps[app_type], upi_apps[App Group] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 508da339-27dc-4d46-a5ba-c38288db281a

	measure 'Volume YoY %' =
			VAR d = MAX ( 'Calendar'[Date] )
			VAR prev =
			    CALCULATE ( [Volume (Mn)], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Date] = EDATE ( d, -12 ) )
			RETURN
			    DIVIDE ( [Volume (Mn)] - prev, prev )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 395ef7dc-0935-434f-8cf3-97084513fa27

	measure 'Top 2 Share' =
			DIVIDE (
			    CALCULATE ( [Volume (Mn)], upi_apps[app] IN { "PhonePe", "Google Pay" } ),
			    CALCULATE ( [Volume (Mn)], REMOVEFILTERS ( upi_apps[app], upi_apps[app_type], upi_apps[App Group] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b2df9bcc-f60d-4ec8-83ad-559d078d536b

	measure HHI = SUMX ( VALUES ( upi_apps[app] ), ( [Volume Share] * 100 ) ^ 2 )
		formatString: #,0
		lineageTag: ad9e1892-17fc-454e-9daf-5cde41e3aa55

	measure 'Share Change 12M' =
			VAR d = MAX ( 'Calendar'[Date] )
			RETURN
			    [Volume Share]
			        - CALCULATE ( [Volume Share], REMOVEFILTERS ( 'Calendar' ), 'Calendar'[Date] = EDATE ( d, -12 ) )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 7912d17b-ef92-499a-9ec0-41168a0ce1cd

	measure 'Latest Volume (Bn)' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Volume (Mn)], 'Calendar'[Date] = m ) / 1000
		formatString: #,0.0
		lineageTag: 929d4c90-235e-48a9-9e9c-294174c35933

	measure 'Latest Value (₹ Lakh Cr)' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Value (Cr)], 'Calendar'[Date] = m ) / 100000
		formatString: #,0.0
		lineageTag: 40993028-bcac-426f-86d9-e8ff16f3084e

	measure 'Latest Avg Ticket (₹)' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Avg Ticket (₹)], 'Calendar'[Date] = m )
		formatString: #,0
		lineageTag: be3b7117-2be3-4f6b-91da-d100a3636b20

	measure 'Latest YoY %' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Volume YoY %], 'Calendar'[Date] = m )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f918e044-0fe5-4ead-94d3-f96de3ecde1f

	measure 'Latest Volume (Mn)' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Volume (Mn)], 'Calendar'[Date] = m )
		formatString: #,0
		lineageTag: 70b0a06d-0183-4533-917d-dc43ed374bb6

	measure 'Latest Share' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Volume Share], 'Calendar'[Date] = m )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 22747f18-3b38-4508-b9eb-fadddf8f5a43

	measure 'Latest Share Change' =
			VAR m = CALCULATE ( MAX ( upi_apps[month] ), REMOVEFILTERS () )
			RETURN
			    CALCULATE ( [Share Change 12M], 'Calendar'[Date] = m )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 9f315f64-af78-4ca0-a054-e8121b75eb56

	column month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 7966f93b-d63f-4090-ab3d-517a6a7c4edc
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column raw_name
		dataType: string
		lineageTag: 1074309e-676f-47ad-a327-26f0489bf704
		summarizeBy: none
		sourceColumn: raw_name

		annotation SummarizationSetBy = Automatic

	column volume_mn
		dataType: double
		formatString: #,0
		lineageTag: 9c76ae25-3215-4fe7-86df-2c49cca341e9
		summarizeBy: sum
		sourceColumn: volume_mn

		annotation SummarizationSetBy = Automatic

	column value_cr
		dataType: double
		formatString: #,0
		lineageTag: 342601b9-854d-4409-814a-d92690d1d345
		summarizeBy: sum
		sourceColumn: value_cr

		annotation SummarizationSetBy = Automatic

	column app
		dataType: string
		lineageTag: d4b8d8ea-456b-495d-a02a-da2bd2556805
		summarizeBy: none
		sourceColumn: app

		annotation SummarizationSetBy = Automatic

	column app_type
		dataType: string
		lineageTag: 4294a8f5-f3b5-49f0-8668-e5c8e9c3aad2
		summarizeBy: none
		sourceColumn: app_type

		annotation SummarizationSetBy = Automatic

	column 'App Group' = IF ( upi_apps[app] IN { "PhonePe", "Google Pay", "Paytm", "Navi" }, upi_apps[app], "Others" )
		dataType: string
		lineageTag: 597e05b0-dd33-4b60-904a-c4583a33b077
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition upi_apps = m
		mode: import
		source =
				let
				    Source = Folder.Files(DataFolder),
				    Files = Table.SelectRows(Source, each [Extension] = ".xlsx"),
				    WithMonth = Table.AddColumn(Files, "month", each Date.FromText(Text.Middle([Name], 9, 7) & "-01"), type date),
				    Read = Table.AddColumn(WithMonth, "rows", each fnReadMonth([Content])),
				    Expanded = Table.ExpandTableColumn(Table.SelectColumns(Read, {"month", "rows"}), "rows", {"raw_name", "volume_mn", "value_cr"}),
				    Typed = Table.TransformColumnTypes(Expanded, {{"raw_name", type text}, {"volume_mn", type number}, {"value_cr", type number}}),
				    Joined = Table.NestedJoin(Typed, "raw_name", app_names, "raw_name", "map", JoinKind.LeftOuter),
				    Result = Table.ExpandTableColumn(Joined, "map", {"app", "app_type"})
				in
				    Result

	annotation PBI_ResultType = Table

